[Unit]
Description=OpenXS exploit-scan daemon
After=network.target
# See openxs-watchd.service's own comment - fires an alert email on any
# failure of this unit, OOM-kill included.
OnFailure=openxs-alert@%N.service

[Service]
Type=simple
RuntimeDirectory=openxs
ExecStart=/usr/bin/python3 /opt/php-malware-finder/openxs-scand.py
Restart=on-failure
RestartSec=2
# Same kernel-enforced hard backstop as openxs-watchd.service - see
# that file's comment. Independent of the in-process OPENXS_SCAND_MAX_RSS_MB
# check.
MemoryMax=1536M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
