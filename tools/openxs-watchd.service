[Unit]
Description=OpenXS watch daemon (account-wide inotify monitor)
After=network.target
# Fires openxs-alert@.service (sends an email) on ANY failure of this
# unit - including the MemoryMax/MemorySwapMax=0 OOM-kill below, which
# gives this process's own Python code no chance to run anything before
# SIGKILL. The in-process checks (check_rss_guard) already log their own
# reason; this is what actually reaches the admin's inbox either way.
OnFailure=openxs-alert@%N.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/php-malware-finder/openxs-watchd.py
Restart=on-failure
RestartSec=2
# watchd exits 3 when the tree is too big to watch (WATCH_MAX_DIRS) -
# alert, but don't loop re-walking it every 2s
RestartPreventExitStatus=3
# Kernel-enforced hard backstop, independent of WATCHD_MAX_RSS_MB's own
# in-process check (which only runs between events - found for real
# that it never got a chance to run again once a single event's own
# processing got stuck, growing memory the whole time with no in-
# process code path left to catch it). The cgroup memory controller
# kills this unit outright if it ever crosses this line, no matter what
# the process itself is doing - Restart=on-failure brings it straight
# back, same as the in-process checks already do for the common case.
# MemorySwapMax=0 matters as much as MemoryMax itself: without it, the
# cgroup tries hard to reclaim (swap out/in) before ever reaching for
# the OOM killer - found for real that this left the process stuck for
# minutes in D-state swap I/O, past the limit, immune to SIGKILL/SIGTERM
# until a page fault finally resolved (a D-state process cannot be
# killed by any signal until it leaves that state). No swap for this
# cgroup means a breach is killed immediately, not slowly thrashed.
#
# 1536M was too tight: rebuilding the recursive inotify watch tree after
# ANY restart (including the in-process check's own graceful self-exit
# above) is a real memory burst that happens before any event has
# arrived for check_rss_guard to run against - found for real on
# a production host (3 OOM-kills across two restarts, one pair 80s
# apart, 2026-10-24 and 2026-10-27) with steady-state already at ~1.1G.
# Raised for headroom during that burst, not because steady-state grew.
MemoryMax=2304M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
